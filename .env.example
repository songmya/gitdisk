# GitHub PAT. Keep this secret. For private repos, use minimum repo permissions needed.
GITHUB_TOKEN=YOUR_GITHUB_TOKEN
GITHUB_OWNER=YOUR_GITHUB_OWNER
GITHUB_REPO=gitdisk-storage
GITHUB_RELEASE_TAG=gitdisk

# Optional outbound proxy for GitHub API/upload/download.
# Example: PROXY=http://user:pass@host:port
PROXY=

DB_PATH=data/gitdisk.sqlite3
MAX_FILE_SIZE_MB=0

# Files larger than GITHUB_SINGLE_UPLOAD_THRESHOLD_MB are split into multiple
# GitHub Release Assets. Keep each chunk below GitHub's ~2GiB asset limit.
GITHUB_CHUNK_SIZE_MB=1900
GITHUB_SINGLE_UPLOAD_THRESHOLD_MB=1900

UPLOAD_CACHE_DIR=data/cache

# Optional: require Authorization: Bearer <WEB_AUTH_TOKEN> for mutating/download APIs.
# Leave empty to disable auth, useful only behind a trusted reverse proxy.
WEB_AUTH_TOKEN=

LOG_LEVEL=INFO
