# GitHub PAT. Keep this secret. For private repos, use minimum repo permissions needed.
GITHUB_TOKEN=YOUR_GITHUB_TOKEN
GITHUB_OWNER=YOUR_GITHUB_OWNER
GITHUB_REPO=gitdisk-storage
GITHUB_RELEASE_TAG=gitdisk

DB_PATH=data/gitdisk.sqlite3
MAX_FILE_SIZE_MB=0
UPLOAD_CACHE_DIR=data/cache

# Optional: require Authorization: Bearer <WEB_AUTH_TOKEN> for mutating/download APIs.
# Leave empty to disable auth, useful only behind a trusted reverse proxy.
WEB_AUTH_TOKEN=

LOG_LEVEL=INFO
